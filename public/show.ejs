<% layout("/layouts/boilerplate")%>
    <div class="container mt-5">
        <div class="row">
            <div class="col-lg-8 offset-lg-2">
                <div class="card shadow mb-5">
                    <img src="<%= listing.profilepic.url %>" class="card-img-top" alt="<%= listing.name %>"
                        style="height: 300px; object-fit: cover;">
                    <div class="card-body p-4">
                        <h2 class="card-title text-center mb-4">
                            <%= listing.name %>
                        </h2>
                        <div class="row">
                            <div class="col-md-6">
                                <p><i class="fas fa-info-circle me-2"></i><strong>Description:</strong>
                                    <%= listing.description %>
                                </p>
                                <p><i class="fas fa-globe me-2"></i><strong>Country:</strong>
                                    <%= listing.country %>
                                </p>
                                <p><i class="fas fa-map-marker-alt me-2"></i><strong>Location:</strong>
                                    <%= listing.location %>
                                </p>
                            </div>
                            <div class="col-md-6">
                                <p><i class="fas fa-dollar-sign me-2"></i><strong>Charges:</strong> $<%= listing.charges
                                        %> / Day</p>
                                <p><i class="fas fa-phone me-2"></i><strong>Contact:</strong>
                                    <%= listing.contact %>
                                </p>
                                <p><i class="fas fa-birthday-cake me-2"></i><strong>Age:</strong>
                                    <%= listing.age %>
                                </p>
                            </div>
                        </div>
                        <% if (listing.introv) { %>
                            <div class="mt-4">
                                <h5><i class="fas fa-video me-2"></i>Introduction Video</h5>
                                <div class="ratio ratio-16x9">
                                    <video controls>
                                        <source src="<%= listing.introv %>" type="video/mp4">
                                        Your browser does not support the video tag.
                                    </video>
                                </div>
                            </div>
                            <% } %>
                    </div>
                    <div class="card-footer d-flex justify-content-between p-3">
                        <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-primary"><i
                                class="fas fa-edit me-2"></i>Edit</a>
                        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                            <button class="btn btn-outline-danger"><i class="fas fa-trash-alt me-2"></i>Delete</button>
                        </form>
                    </div>
                </div>

                <!-- Reviews Section -->
                <div class="card shadow mb-5 px-2 py-4">
                    <div class="card-body p-4">
                        <h4 class="mb-4"><i class="fas fa-comment me-2"></i>Leave a Review</h4>
                        <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate
                            class="needs-validation">
                            <div class="mb-3">
                                <label for="rating" class="form-label">Rating</label>
                                <input type="range" min="1" max="5" id="rating" name="review[rating]"
                                    class="form-range">
                                <div class="rating-value text-center">3</div>
                            </div>
                            <div class="mb-3">
                                <label for="comment" class="form-label">Comments</label>
                                <textarea name="review[comment]" id="comment" rows="3" class="form-control"
                                    required></textarea>
                                <div class="invalid-feedback">Please add some comments for review</div>
                            </div>
                            <button class="btn btn-primary"><i class="fas fa-paper-plane me-2"></i>Submit
                                Review</button>
                        </form>
                    </div>
                </div>

                <!-- Existing Reviews -->
                <h4 class="mb-3"><i class="fas fa-comments me-2"></i>All Reviews</h4>
                <div class="row">
                    <% for(review of listing.reviews){ %>
                        <div class="col-md-6 mb-3">
                            <div class="card h-100">
                                <div class="card-body p-3">
                                    <h5 class="card-title">Mihir</h5>
                                    <p class="card-text">
                                        <%= review.comment %>
                                    </p>
                                    <p class="card-text">
                                        <small class="text-muted">
                                            <%= "★" .repeat(review.rating) %>
                                                <%= "☆" .repeat(5 - review.rating) %>
                                        </small>
                                    </p>
                                </div>
                                <div class="card-footer p-3">
                                    <form method="POST"
                                        action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                        <button class="btn btn-sm btn-outline-danger"><i
                                                class="fas fa-trash-alt me-2"></i>Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <% } %>
                </div>
            </div>
        </div>
    </div>

    <style>
        body {
            background-color: #f8f9fa;
        }

        .card {
            border: none;
            border-radius: 15px;
            overflow: hidden;
        }

        .btn-primary,
        .btn-outline-primary {
            color: #fff;
            background-color: #fe424d;
            border-color: #fe424d;
        }

        .btn-primary:hover,
        .btn-outline-primary:hover {
            background-color: #e63b45;
            border-color: #e63b45;
        }

        .btn-outline-primary {
            color: #fe424d;
            background-color: transparent;
        }

        .btn-outline-primary:hover {
            color: #fff;
        }

        .rating-value {
            font-size: 1.2rem;
            font-weight: bold;
        }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const ratingInput = document.getElementById('rating');
            const ratingValue = document.querySelector('.rating-value');

            ratingInput.addEventListener('input', function () {
                ratingValue.textContent = this.value;
            });
        });
    </script>