<% layout("/layouts/boilerplate")%>
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-10">
                <div class="card shadow-sm">
                    <div class="card-body p-4">
                        <h1 class="text-center mb-4">Edit Translator Details</h1>
                        <form method="POST" action="/listings/<%= listing._id%>?_method=PUT" novalidate
                            class="needs-validation" enctype="multipart/form-data">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="name" class="form-label">Name</label>
                                    <input name="listing[name]" value="<%= listing.name %>" type="text"
                                        class="form-control" required>
                                    <div class="valid-feedback">Name looks good</div>
                                </div>
                                <div class="col-md-6">
                                    <label for="age" class="form-label">Age</label>
                                    <input name="listing[age]" value="<%= listing.age %>" type="number"
                                        class="form-control" required>
                                    <div class="invalid-feedback">Please enter a valid age</div>
                                </div>
                                <div class="col-12">
                                    <label for="description" class="form-label">Description</label>
                                    <textarea name="listing[description]" class="form-control" rows="3"
                                        required><%= listing.description %></textarea>
                                    <div class="invalid-feedback">Please enter a short description</div>
                                </div>
                                <div class="col-md-6">
                                    <label for="charges" class="form-label">Charges (per day)</label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input name="listing[charges]" value="<%= listing.charges %>" type="number"
                                            class="form-control" required>
                                    </div>
                                    <div class="invalid-feedback">Please enter valid charges</div>
                                </div>
                                <div class="col-md-6">
                                    <label for="contact" class="form-label">Contact Number</label>
                                    <input name="listing[contact]" value="<%= listing.contact %>" type="tel"
                                        class="form-control" required>
                                    <div class="invalid-feedback">Please enter a valid contact number</div>
                                </div>
                                <div class="col-md-6">
                                    <label for="country" class="form-label">Country</label>
                                    <input name="listing[country]" value="<%= listing.country %>" type="text"
                                        class="form-control" required>
                                    <div class="invalid-feedback">Please enter a valid country</div>
                                </div>
                                <div class="col-md-6">
                                    <label for="location" class="form-label">Location</label>
                                    <input name="listing[location]" value="<%= listing.location %>" type="text"
                                        class="form-control" required>
                                    <div class="invalid-feedback">Please enter a valid location</div>
                                </div>
                                <div class="col-md-4">
                                    <label for="profilepic" class="form-label">Profile Picture</label>
                                    <input name="listing[profilepic]" type="file" class="form-control" accept="image/*">
                                </div>
                                <div class="col-md-4">
                                    <label for="languagecpic" class="form-label">Language Certificate</label>
                                    <input name="listing[languagecpic]" type="file" class="form-control"
                                        accept="image/*,application/pdf">
                                </div>
                                <div class="col-md-4">
                                    <label for="introv" class="form-label">Introduction Video</label>
                                    <input name="listing[introv]" type="file" class="form-control" accept="video/*">
                                </div>
                                <div class="col-12">
                                    <button type="submit" class="btn btn-primary w-100">Update Translator</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        body {
            background-color: #f8f9fa;
        }

        .card {
            border: none;
            border-radius: 15px;
            overflow: hidden;
        }

        .btn-primary {
            background-color: #fe424d;
            border-color: #fe424d;
        }

        .btn-primary:hover {
            background-color: #e63b45;
            border-color: #e63b45;
        }

        .form-control:focus {
            border-color: #fe424d;
            box-shadow: 0 0 0 0.2rem rgba(254, 66, 77, 0.25);
        }
    </style>