<% layout("/layouts/boilerplate") %>

    <div class="container mt-5">
        <div class="alert alert-success mb-4" role="alert">
            <h4 class="alert-heading"><i class="fas fa-filter me-2"></i>Filtered Studens</h4>
            <p class="mb-0">Here are the students based on your criteria</p>
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            <% for(let student of filteredStudents) { %>
                <div class="col">
                    <a href="/students/<%= student._id %>" class="text-decoration-none">
                        <div class="card h-100 shadow-sm listing-card">
                            <img src="<%= student.profilepic.url %>" class="card-img-top" alt="<%= student.name %>"
                                style="height: 200px; object-fit: cover;">
                            <div class="card-body">
                                <h5 class="card-title">
                                    <%= student.name %>
                                </h5>
                                <p class="card-text">
                                    <%= student.description %>
                                </p>
                                <p class="card-text"><small class="text-muted"><i class="fas fa-globe me-2"></i>
                                        <%= student.country %>
                                    </small></p>
                            </div>
                        </div>
                    </a>
                </div>
                <% } %>
        </div>
    </div>

    <style>
        body {
            background-color: #f8f9fa;
        }

        .card {
            transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
            border: none;
            border-radius: 15px;
            overflow: hidden;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1) !important;
        }

        .alert-success {
            background-color: #d4edda;
            border-color: #c3e6cb;
            color: #155724;
        }
    </style>