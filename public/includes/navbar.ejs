<style>
  .navbar {
    box-shadow: 0 2px 10px rgba(0, 0, 0, .1);
    padding: 0.5rem 1rem;
  }

  .navbar-brand {
    color: #fe424d;
    font-weight: bold;
    font-size: 1.5rem;
    transition: color 0.3s ease;
  }

  .navbar-brand:hover {
    color: #e63a45;
  }

  .nav-link {
    color: #333;
    font-weight: 500;
    transition: color 0.3s ease, background-color 0.3s ease;
    border-radius: 5px;
    padding: 0.5rem 1rem !important;
  }

  .nav-link:hover {
    color: #fe424d;
    background-color: rgba(254, 66, 77, 0.1);
  }

  .btn-outline-primary {
    color: #fe424d;
    border-color: #fe424d;
  }

  .btn-outline-primary:hover {
    background-color: #fe424d;
    border-color: #fe424d;
    color: white;
  }

  .btn-primary {
    background-color: #fe424d;
    border-color: #fe424d;
  }

  .btn-primary:hover {
    background-color: #e63a45;
    border-color: #e63a45;
  }

  .form-control:focus {
    box-shadow: 0 0 0 0.2rem rgba(254, 66, 77, 0.25);
    border-color: #fe424d;
  }

  .navbar-nav .nav-item {
    margin-right: 0.5rem;
  }

  .navbar-toggler {
    border-color: rgba(254, 66, 77, 0.1);
  }

  .navbar-toggler:focus {
    box-shadow: 0 0 0 0.2rem rgba(254, 66, 77, 0.25);
  }

  @media (max-width: 991.98px) {
    .navbar-nav {
      margin-top: 1rem;
    }

    .nav-item {
      margin-bottom: 0.5rem;
    }

    .form-inline {
      width: 100%;
      margin-bottom: 1rem;
    }
  }
</style>

<nav class="navbar navbar-expand-lg navbar-light bg-white">
    <div class="container">
        <a class="navbar-brand" href="/listings">
            <i class="fa-solid fa-language"></i> WouldTrans
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
            aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarContent">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link" href="/listings">All Translators</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/listings/new">Add New Translator</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/listings">Corporate Translators</a>
                </li>
            </ul>
            <form class="d-flex mb-2 mb-lg-0 me-lg-3" role="search" action="/listings" method="GET">
                <div class="input-group">
                    <input class="form-control" type="search" name="search" placeholder="Search translators" aria-label="Search"
                        autocomplete="off">
                    <button class="btn btn-outline-primary" type="submit">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                </div>
            </form>
            <ul class="navbar-nav">
                <% if(!currUser) { %>
                    <li class="nav-item">
                        <a class="nav-link btn btn-outline-primary me-2" href="/signup">Sign Up</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link btn btn-primary" href="/login">Log In</a>
                    </li>
                <% } else { %>
                    <li class="nav-item">
                        <a class="nav-link btn btn-outline-primary" href="/logout">Log Out</a>
                    </li>
                <% } %>
            </ul>
        </div>
    </div>
</nav>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>