<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Translator Hire</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .profile-dropdown {
            position: relative;
            display: inline-block;
        }
        
        .profile-dropdown-content {
            display: none;
            position: absolute;
            right: 0;
            background-color: #f9f9f9;
            min-width: 250px;
            box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
            z-index: 1;
            border-radius: 4px;
        }
        
        .profile-dropdown:hover .profile-dropdown-content {
            display: block;
        }
        
        .profile-header {
            padding: 12px 16px;
            background-color: #f1f1f1;
            border-bottom: 1px solid #ddd;
        }
        
        .profile-item {
            padding: 12px 16px;
            text-decoration: none;
            display: block;
            color: #333;
            border-bottom: 1px solid #ddd;
        }
        
        .profile-item:hover {
            background-color: #f1f1f1;
        }
        
        .profile-icon {
            margin-right: 8px;
            width: 20px;
            text-align: center;
        }

        .user-info {
            font-size: 0.9rem;
            color: #666;
            margin-top: 4px;
        }

        .user-role {
            font-size: 0.8rem;
            color: #666;
            margin-top: 4px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 8px;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">Translator Hire</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/listings">Translators</a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    <% if(locals.currUser) { %>
                        <li class="nav-item profile-dropdown">
                            <a class="nav-link" href="#" style="display: flex; align-items: center;">
                                <i class="fas fa-user-circle"></i>
                                <span><%= locals.currUser.name || locals.currUser.username %></span>
                            </a>
                            <div class="profile-dropdown-content">
                                <div class="profile-header">
                                    <strong><%= locals.currUser.name || locals.currUser.username %></strong>
                                    <% if(locals.currUser.constructor.modelName === 'User') { %>
                                        <div class="user-role">Translator</div>
                                        <% if(locals.currUser.email) { %>
                                            <div class="user-info">
                                                <i class="fas fa-envelope profile-icon"></i>
                                                <%= locals.currUser.email %>
                                            </div>
                                        <% } %>
                                    <% } else { %>
                                        <div class="user-role">Client</div>
                                        <% if(locals.currUser.location) { %>
                                            <div class="user-info">
                                                <i class="fas fa-map-marker-alt profile-icon"></i>
                                                <%= locals.currUser.location %>, <%= locals.currUser.country %>
                                            </div>
                                        <% } %>
                                        <% if(locals.currUser.preferredLanguages && locals.currUser.preferredLanguages.length > 0) { %>
                                            <div class="user-info">
                                                <i class="fas fa-language profile-icon"></i>
                                                <%= locals.currUser.preferredLanguages.join(', ') %>
                                            </div>
                                        <% } %>
                                    <% } %>
                                </div>
                                <% if(locals.currUser.constructor.modelName === 'User') { %>
                                    <a href="/users/profile" class="profile-item">
                                        <i class="fas fa-user profile-icon"></i>Profile
                                    </a>
                                <% } else { %>
                                    <a href="/client/profile" class="profile-item">
                                        <i class="fas fa-user profile-icon"></i>Profile
                                    </a>
                                <% } %>
                                <a href="/client/logout" class="profile-item">
                                    <i class="fas fa-sign-out-alt profile-icon"></i>Logout
                                </a>
                            </div>
                        </li>
                    <% } else { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/client/login">Client Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/client/signup">Client Signup</a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container mt-3">
        <% if(locals.success) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= locals.success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>
        <% if(locals.error) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <%= locals.error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>
    </div>
</body>
</html> 