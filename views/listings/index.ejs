<%- include('../partials/header') %>

<div class="container mt-5">
    <div class="row">
        <div class="col-12">
            <h2 class="text-center mb-4">Our Translators</h2>
        </div>
    </div>

    <div class="row g-4">
        <% if (listings && listings.length > 0) { %>
            <% listings.forEach(listing => { %>
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 translator-card border-0 shadow-sm">
                        <img src="<%= listing.profilepic.url %>" class="card-img-top" alt="<%= listing.name %>" style="height: 250px; object-fit: cover;">
                        <div class="card-body">
                            <h4 class="card-title mb-3"><%= listing.name %></h4>
                            <p class="card-text text-muted mb-3"><%= listing.description %></p>
                            <div class="d-flex align-items-center mb-2">
                                <i class="fas fa-map-marker-alt text-danger me-2"></i>
                                <span><%= listing.location %>, <%= listing.country %></span>
                            </div>
                            <div class="d-flex align-items-center mb-2">
                                <i class="fas fa-coins text-danger me-2"></i>
                                <span>Charges: ₹<%= listing.charges %></span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <a href="/listings/<%= listing._id %>" class="btn btn-outline-danger">
                                    <i class="fas fa-info-circle me-2"></i>View Details
                                </a>
                                <% if(locals.currUser && !locals.currUser.isTranslator) { %>
                                    <button class="btn btn-danger hire-btn" data-translator-id="<%= listing._id %>">
                                        <i class="fas fa-handshake me-2"></i>Hire
                                    </button>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <div class="col-12">
                <div class="alert alert-info">
                    No translators available at the moment. Please check back later.
                </div>
            </div>
        <% } %>
    </div>
</div>

<style>
    .translator-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border-radius: 10px;
        overflow: hidden;
    }
    .translator-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }
    .translator-card img {
        transition: transform 0.3s ease;
    }
    .translator-card:hover img {
        transform: scale(1.05);
    }
    .translator-card .card-body {
        padding: 1.5rem;
    }
    .translator-card .btn {
        border-radius: 25px;
        padding: 8px 16px;
    }
    .translator-card .card-title {
        color: #2c3e50;
        font-weight: 600;
    }
    .g-4 {
        --bs-gutter-x: 2rem;
        --bs-gutter-y: 2rem;
    }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const hireButtons = document.querySelectorAll('.hire-btn');
    
    hireButtons.forEach(button => {
        button.addEventListener('click', async function() {
            if (!confirm('Are you sure you want to hire this translator?')) {
                return;
            }
            
            const translatorId = this.dataset.translatorId;
            const button = this;
            button.disabled = true;
            button.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Processing...';
            
            try {
                const response = await fetch('/client/hire', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ translatorId }),
                });
                
                const data = await response.json();
                
                if (data.success) {
                    alert('Successfully hired the translator!');
                    window.location.href = '/client/dashboard';
                } else {
                    alert(data.message || 'Failed to hire translator');
                    button.disabled = false;
                    button.innerHTML = '<i class="fas fa-handshake me-2"></i>Hire';
                }
            } catch (error) {
                console.error('Error:', error);
                alert('An error occurred while hiring the translator');
                button.disabled = false;
                button.innerHTML = '<i class="fas fa-handshake me-2"></i>Hire';
            }
        });
    });
});
</script>

<%- include('../partials/footer') %> 