<%- include('../partials/header') %>

<div class="container mt-5">
    <% if (error && error.length > 0) { %>
        <div class="alert alert-danger">
            <%= error %>
        </div>
    <% } %>
    
    <% if (success && success.length > 0) { %>
        <div class="alert alert-success">
            <%= success %>
        </div>
    <% } %>

    <div class="row">
        <!-- Translator Profile -->
        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <img src="<%= translator.profileImage %>" class="card-img-top" alt="<%= translator.name %>">
                <div class="card-body">
                    <h5 class="card-title"><%= translator.name %></h5>
                    <p class="text-muted">
                        <i class="fas fa-map-marker-alt"></i> <%= translator.location %>, <%= translator.country %>
                    </p>
                    <div class="mb-3">
                        <h6>Rating</h6>
                        <div class="d-flex align-items-center">
                            <div class="text-warning">
                                <% for(let i = 0; i < 5; i++) { %>
                                    <% if (i < averageRating) { %>
                                        <i class="fas fa-star"></i>
                                    <% } else { %>
                                        <i class="far fa-star"></i>
                                    <% } %>
                                <% } %>
                            </div>
                            <span class="ms-2">(<%= averageRating %>)</span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <h6>Languages</h6>
                        <div class="d-flex flex-wrap gap-2">
                            <% translator.languages.forEach(language => { %>
                                <span class="badge bg-primary"><%= language %></span>
                            <% }); %>
                        </div>
                    </div>
                    <div class="mb-3">
                        <h6>Experience</h6>
                        <p><%= translator.experience %> years</p>
                    </div>
                    <div class="mb-3">
                        <h6>Rate</h6>
                        <p>$<%= translator.charges %> per hour</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Hire Form -->
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">Hire <%= translator.name %></h5>
                </div>
                <div class="card-body">
                    <form action="/client/translator/<%= translator._id %>/hire" method="POST">
                        <div class="mb-3">
                            <label for="description" class="form-label">Project Description</label>
                            <textarea class="form-control" id="description" name="description" rows="4" required></textarea>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="sourceLanguage" class="form-label">Source Language</label>
                                <select class="form-select" id="sourceLanguage" name="sourceLanguage" required>
                                    <option value="">Select source language</option>
                                    <% translator.languages.forEach(language => { %>
                                        <option value="<%= language %>"><%= language %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="targetLanguage" class="form-label">Target Language</label>
                                <select class="form-select" id="targetLanguage" name="targetLanguage" required>
                                    <option value="">Select target language</option>
                                    <% translator.languages.forEach(language => { %>
                                        <option value="<%= language %>"><%= language %></option>
                                    <% }); %>
                                </select>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="deadline" class="form-label">Deadline</label>
                                <input type="date" class="form-control" id="deadline" name="deadline" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="budget" class="form-label">Budget ($)</label>
                                <input type="number" class="form-control" id="budget" name="budget" min="0" step="0.01" required>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-danger">Send Hiring Request</button>
                    </form>
                </div>
            </div>

            <!-- Completed Projects -->
            <% if (projects.length > 0) { %>
                <div class="card shadow-sm mt-4">
                    <div class="card-header bg-danger text-white">
                        <h5 class="mb-0">Completed Projects</h5>
                    </div>
                    <div class="card-body">
                        <div class="list-group">
                            <% projects.forEach(project => { %>
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h6 class="mb-1"><%= project.description %></h6>
                                        <span class="badge bg-success">Completed</span>
                                    </div>
                                    <p class="mb-1">
                                        <small class="text-muted">
                                            Client: <%= project.client.name %>
                                        </small>
                                    </p>
                                    <% if (project.rating) { %>
                                        <div class="text-warning">
                                            <% for(let i = 0; i < 5; i++) { %>
                                                <% if (i < project.rating) { %>
                                                    <i class="fas fa-star"></i>
                                                <% } else { %>
                                                    <i class="far fa-star"></i>
                                                <% } %>
                                            <% } %>
                                        </div>
                                    <% } %>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>

<%- include('../partials/footer') %> 