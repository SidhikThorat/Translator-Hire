<%- include('../../partials/header') %>

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8">
            <!-- Project Details -->
            <div class="card shadow mb-4">
                <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><%= project.title %></h4>
                    <span class="badge bg-light text-dark"><%= project.status %></span>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <h5>Description</h5>
                        <p><%= project.description %></p>
                    </div>
                    
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h5>Project Details</h5>
                            <ul class="list-unstyled">
                                <li><strong>Source Language:</strong> <%= project.sourceLanguage %></li>
                                <li><strong>Target Language:</strong> <%= project.targetLanguage %></li>
                                <li><strong>Category:</strong> <%= project.category %></li>
                                <li><strong>Budget:</strong> $<%= project.budget %></li>
                                <li><strong>Deadline:</strong> <%= new Date(project.deadline).toLocaleDateString() %></li>
                                <li><strong>Created:</strong> <%= new Date(project.createdAt).toLocaleDateString() %></li>
                            </ul>
                        </div>
                        
                        <div class="col-md-6">
                            <h5>Translator</h5>
                            <% if(project.translator) { %>
                                <div class="d-flex align-items-center">
                                    <img src="<%= project.translator.profileImage %>" alt="Translator" class="rounded-circle me-3" style="width: 50px; height: 50px;">
                                    <div>
                                        <h6 class="mb-0"><%= project.translator.name %></h6>
                                        <small class="text-muted">Assigned Translator</small>
                                    </div>
                                </div>
                            <% } else { %>
                                <p class="text-muted">No translator assigned yet</p>
                            <% } %>
                        </div>
                    </div>
                    
                    <!-- Files Section -->
                    <% if(project.files && project.files.length > 0) { %>
                        <div class="mb-4">
                            <h5>Project Files</h5>
                            <div class="list-group">
                                <% project.files.forEach(file => { %>
                                    <a href="<%= file.url %>" class="list-group-item list-group-item-action" target="_blank">
                                        <div class="d-flex w-100 justify-content-between">
                                            <h6 class="mb-1"><%= file.originalName %></h6>
                                            <small><%= (file.size / 1024).toFixed(2) %> KB</small>
                                        </div>
                                        <small class="text-muted">Uploaded: <%= new Date(file.uploadedAt).toLocaleDateString() %></small>
                                    </a>
                                <% }) %>
                            </div>
                        </div>
                    <% } %>
                    
                    <!-- Milestones -->
                    <% if(project.milestones && project.milestones.length > 0) { %>
                        <div class="mb-4">
                            <h5>Project Milestones</h5>
                            <div class="list-group">
                                <% project.milestones.forEach(milestone => { %>
                                    <div class="list-group-item">
                                        <div class="d-flex w-100 justify-content-between">
                                            <h6 class="mb-1"><%= milestone.title %></h6>
                                            <span class="badge bg-<%= milestone.status === 'completed' ? 'success' : 'warning' %>">
                                                <%= milestone.status %>
                                            </span>
                                        </div>
                                        <p class="mb-1"><%= milestone.description %></p>
                                        <small class="text-muted">Due: <%= new Date(milestone.dueDate).toLocaleDateString() %></small>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
            
            <!-- Messages Section -->
            <div class="card shadow mb-4">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">Messages</h5>
                </div>
                <div class="card-body">
                    <div class="messages-container" style="max-height: 300px; overflow-y: auto;">
                        <% project.messages.forEach(message => { %>
                            <div class="message mb-3 <%= message.sender === 'client' ? 'text-end' : 'text-start' %>">
                                <div class="message-content p-3 rounded <%= message.sender === 'client' ? 'bg-danger text-white' : 'bg-light' %>" style="max-width: 80%; display: inline-block;">
                                    <%= message.content %>
                                </div>
                                <div class="text-muted small">
                                    <%= new Date(message.timestamp).toLocaleString() %>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                    
                    <form action="/client/projects/<%= project._id %>/messages" method="POST" class="mt-3">
                        <div class="input-group">
                            <input type="text" class="form-control" name="content" placeholder="Type your message..." required>
                            <button type="submit" class="btn btn-danger">Send</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <!-- Actions Card -->
            <div class="card shadow mb-4">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="/client/projects/<%= project._id %>/edit" class="btn btn-outline-danger">Edit Project</a>
                        <form action="/client/projects/<%= project._id %>?_method=DELETE" method="POST" class="d-grid">
                            <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Are you sure you want to delete this project?')">Delete Project</button>
                        </form>
                    </div>
                </div>
            </div>
            
            <!-- Review Section -->
            <% if(project.status === 'completed' && !project.rating) { %>
                <div class="card shadow">
                    <div class="card-header bg-danger text-white">
                        <h5 class="mb-0">Rate & Review</h5>
                    </div>
                    <div class="card-body">
                        <form action="/client/projects/<%= project._id %>/review" method="POST">
                            <div class="mb-3">
                                <label class="form-label">Rating</label>
                                <div class="rating">
                                    <% for(let i = 1; i <= 5; i++) { %>
                                        <input type="radio" name="rating" value="<%= i %>" id="star<%= i %>" required>
                                        <label for="star<%= i %>" class="star">★</label>
                                    <% } %>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label for="review" class="form-label">Review</label>
                                <textarea class="form-control" id="review" name="review" rows="3" required></textarea>
                            </div>
                            <button type="submit" class="btn btn-danger w-100">Submit Review</button>
                        </form>
                    </div>
                </div>
            <% } else if(project.rating) { %>
                <div class="card shadow">
                    <div class="card-header bg-danger text-white">
                        <h5 class="mb-0">Your Review</h5>
                    </div>
                    <div class="card-body">
                        <div class="rating mb-2">
                            <% for(let i = 1; i <= 5; i++) { %>
                                <span class="star <%= i <= project.rating ? 'text-warning' : 'text-muted' %>">★</span>
                            <% } %>
                        </div>
                        <p><%= project.review %></p>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>

<style>
    .rating {
        display: flex;
        flex-direction: row-reverse;
        justify-content: flex-end;
    }
    
    .rating input {
        display: none;
    }
    
    .rating label {
        cursor: pointer;
        font-size: 2rem;
        color: #ddd;
        transition: color 0.3s;
    }
    
    .rating input:checked ~ label,
    .rating label:hover,
    .rating label:hover ~ label {
        color: #ffc107;
    }
    
    .message-content {
        word-wrap: break-word;
    }
</style>

<%- include('../../partials/footer') %> 