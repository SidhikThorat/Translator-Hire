<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Manual - Translator Hire</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/styles/main.css">
</head>
<body>
    <%- include('partials/header') %>
    
    <div class="container my-5">
        <div class="row">
            <div class="col-md-8 mx-auto text-center">
                <h1 class="display-4 mb-4">User Manual</h1>
                <p class="lead">Choose your role to view the detailed guide</p>
            </div>
        </div>

        <div class="row mt-5">
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-language fa-4x text-danger mb-4"></i>
                        <h2 class="card-title">Translator Guide</h2>
                        <p class="card-text">Learn how to create your profile, manage projects, and work with clients effectively.</p>
                        <a href="/manual/translator" class="btn btn-danger mt-3">View Translator Guide</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <i class="fas fa-user-tie fa-4x text-danger mb-4"></i>
                        <h2 class="card-title">Client Guide</h2>
                        <p class="card-text">Discover how to find translators, post projects, and manage your translation needs.</p>
                        <a href="/manual/client" class="btn btn-danger mt-3">View Client Guide</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html> 