<%- include('partials/header') %>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-10 text-center">
            <h1 class="display-4 mb-4">Welcome to Translator Hire</h1>
            <p class="lead mb-5">Connect with professional translators or find translation services</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-5 mb-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <h2 class="card-title mb-4">I am a Translator</h2>
                    <p class="card-text mb-4">Join our platform to offer your translation services and connect with clients worldwide.</p>
                    <div class="d-grid gap-2">
                        <a href="/login" class="btn btn-primary">Login</a>
                        <a href="/signup" class="btn btn-outline-primary">Sign Up</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-5 mb-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <h2 class="card-title mb-4">I am a Client</h2>
                    <p class="card-text mb-4">Find and hire professional translators for your needs.</p>
                    <div class="d-grid gap-2">
                        <a href="/client/login" class="btn btn-primary">Login</a>
                        <a href="/client/signup" class="btn btn-outline-primary">Sign Up</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %> 