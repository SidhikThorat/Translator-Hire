<%- include('../partials/header') %>

<div class="container mt-4">
    <div class="row">
        <!-- Profile Section -->
        <div class="col-md-4">
            <div class="card shadow mb-4">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">Profile</h5>
                </div>
                <div class="card-body text-center">
                    <% if(translator.profileImage) { %>
                        <img src="<%= translator.profileImage %>" class="rounded-circle mb-3" style="width: 150px; height: 150px; object-fit: cover;" alt="Profile Image">
                    <% } else { %>
                        <img src="/images/default-profile.png" class="rounded-circle mb-3" style="width: 150px; height: 150px; object-fit: cover;" alt="Default Profile">
                    <% } %>
                    <h4><%= translator.name %></h4>
                    <p class="text-muted"><%= translator.location %>, <%= translator.country %></p>
                    <div class="d-flex align-items-center justify-content-center mb-3">
                        <div class="star-rating">
                            <% for(let i = 1; i <= 5; i++) { %>
                                <% if(i <= Math.floor(translator.averageRating || 0)) { %>
                                    <i class="fas fa-star text-warning"></i>
                                <% } else if(i === Math.ceil(translator.averageRating || 0) && (translator.averageRating || 0) % 1 !== 0) { %>
                                    <i class="fas fa-star-half-alt text-warning"></i>
                                <% } else { %>
                                    <i class="far fa-star text-warning"></i>
                                <% } %>
                            <% } %>
                        </div>
                        <span class="ms-1">(<%= (translator.averageRating || 0).toFixed(1) %>)</span>
                    </div>
                    <p><strong>Experience:</strong> <%= translator.experience %> years</p>
                    <p><strong>Rate:</strong> $<%= translator.charges %>/hour</p>
                    <p><strong>Languages:</strong></p>
                    <div class="mb-3">
                        <% translator.languages.forEach(language => { %>
                            <span class="badge bg-primary me-1"><%= language %></span>
                        <% }) %>
                    </div>
                    <p><strong>Bio:</strong></p>
                    <p class="text-muted"><%= translator.bio %></p>
                    
                    <!-- Introduction Video Section -->
                    <% if(translator.introVideo) { %>
                        <div class="mt-3">
                            <h6 class="mb-2">Introduction Video</h6>
                            <div class="ratio ratio-16x9">
                                <video controls class="w-100">
                                    <source src="<%= translator.introVideo %>" type="video/mp4">
                                    Your browser does not support the video tag.
                                </video>
                            </div>
                        </div>
                    <% } %>
                    
                    <div class="mt-4">
                        <a href="/translator/profile/edit" class="btn btn-outline-danger w-100">
                            <i class="fas fa-edit me-2"></i>Edit Profile
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content Section -->
        <div class="col-md-8">
            <% if(success && success.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <%= success %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>
            <% if(error && error.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <%= error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            <% } %>

            <!-- Hiring Requests -->
            <div class="card shadow mb-4">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">Hiring Requests</h5>
                </div>
                <div class="card-body">
                    <% if(translator.hiringRequests && translator.hiringRequests.length > 0) { %>
                        <% translator.hiringRequests.forEach(project => { %>
                            <div class="card mb-3">
                                <div class="card-body">
                                    <h5 class="card-title"><%= project.title %></h5>
                                    <p class="card-text"><strong>Description:</strong> <%= project.description %></p>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <p class="card-text">
                                                <strong>Source Language:</strong> <%= project.sourceLanguage %><br>
                                                <strong>Target Language:</strong> <%= project.targetLanguage %><br>
                                                <strong>Budget:</strong> $<%= project.budget %>
                                            </p>
                                        </div>
                                        <div class="col-md-6">
                                            <p class="card-text">
                                                <strong>From:</strong> <%= project.client.name %><br>
                                                <strong>Deadline:</strong> <%= new Date(project.deadline).toLocaleDateString() %>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <form action="/translator/projects/<%= project._id %>/accept" method="POST">
                                            <button type="submit" class="btn btn-success">Accept</button>
                                        </form>
                                        <form action="/translator/projects/<%= project._id %>/reject" method="POST">
                                            <button type="submit" class="btn btn-danger">Reject</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p class="text-muted">No hiring requests at the moment.</p>
                    <% } %>
                </div>
            </div>

            <!-- Active Projects -->
            <div class="card shadow mb-4">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">Active Projects</h5>
                </div>
                <div class="card-body">
                    <% if(translator.activeProjects && translator.activeProjects.length > 0) { %>
                        <% translator.activeProjects.forEach(project => { %>
                            <div class="card mb-3">
                                <div class="card-body">
                                    <h5 class="card-title"><%= project.title %></h5>
                                    <p class="card-text"><%= project.description %></p>
                                    <p class="card-text">
                                        <small class="text-muted">
                                            Client: <%= project.client.name %><br>
                                            Deadline: <%= new Date(project.deadline).toLocaleDateString() %>
                                        </small>
                                    </p>
                                    <a href="/translator/projects/<%= project._id %>" class="btn btn-primary">View Details</a>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p class="text-muted">No active projects at the moment.</p>
                    <% } %>
                </div>
            </div>

            <!-- Completed Projects -->
            <div class="card shadow mb-4">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">Completed Projects</h5>
                </div>
                <div class="card-body">
                    <% if(translator.completedProjects && translator.completedProjects.length > 0) { %>
                        <% translator.completedProjects.forEach(project => { %>
                            <div class="card mb-3">
                                <div class="card-body">
                                    <h5 class="card-title"><%= project.title %></h5>
                                    <p class="card-text"><%= project.description %></p>
                                    <p class="card-text">
                                        <small class="text-muted">
                                            Client: <%= project.client.name %><br>
                                            Completed: <%= new Date(project.completedAt).toLocaleDateString() %>
                                        </small>
                                    </p>
                                    <% if(project.rating) { %>
                                        <div class="mb-2">
                                            <% for(let i = 1; i <= 5; i++) { %>
                                                <% if(i <= project.rating) { %>
                                                    <i class="fas fa-star text-warning"></i>
                                                <% } else { %>
                                                    <i class="far fa-star text-warning"></i>
                                                <% } %>
                                            <% } %>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p class="text-muted">No completed projects yet.</p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %> 