<%- include('../partials/header') %>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Edit Profile</h4>
                </div>
                <div class="card-body">
                    <% if(locals.error) { %>
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <%= locals.error %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    <% } %>
                    <% if(locals.success) { %>
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <%= locals.success %>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    <% } %>
                    
                    <form action="/translator/profile/edit" method="POST" enctype="multipart/form-data">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="name" class="form-label">Full Name</label>
                                <input type="text" class="form-control" id="name" name="name" value="<%= translator.name %>" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="email" class="form-label">Email</label>
                                <input type="email" class="form-control" id="email" name="email" value="<%= translator.email %>" required>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="phone" class="form-label">Phone</label>
                                <input type="tel" class="form-control" id="phone" name="phone" value="<%= translator.phone %>" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="age" class="form-label">Age</label>
                                <input type="number" class="form-control" id="age" name="age" value="<%= translator.age %>" required>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="country" class="form-label">Country</label>
                                <input type="text" class="form-control" id="country" name="country" value="<%= translator.country %>" required>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="location" class="form-label">Location</label>
                                <input type="text" class="form-control" id="location" name="location" value="<%= translator.location %>" required>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="gender" class="form-label">Gender</label>
                                <select class="form-select" id="gender" name="gender" required>
                                    <option value="male" <%= translator.gender === 'male' ? 'selected' : '' %>>Male</option>
                                    <option value="female" <%= translator.gender === 'female' ? 'selected' : '' %>>Female</option>
                                    <option value="other" <%= translator.gender === 'other' ? 'selected' : '' %>>Other</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="experience" class="form-label">Years of Experience</label>
                                <input type="number" class="form-control" id="experience" name="experience" value="<%= translator.experience %>" required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="languages" class="form-label">Languages (comma separated)</label>
                            <input type="text" class="form-control" id="languages" name="languages" value="<%= translator.languages.join(', ') %>" required>
                            <small class="text-muted">Example: English, Spanish, French</small>
                        </div>

                        <div class="mb-3">
                            <label for="charges" class="form-label">Hourly Rate ($)</label>
                            <input type="number" class="form-control" id="charges" name="charges" value="<%= translator.charges %>" required>
                        </div>

                        <div class="mb-3">
                            <label for="bio" class="form-label">Bio</label>
                            <textarea class="form-control" id="bio" name="bio" rows="4" required><%= translator.bio %></textarea>
                        </div>

                        <div class="mb-3">
                            <label for="profileImage" class="form-label">Profile Image</label>
                            <input type="file" class="form-control" id="profileImage" name="profileImage" accept="image/*">
                            <% if(translator.profileImage) { %>
                                <div class="mt-2">
                                    <img src="<%= translator.profileImage %>" alt="Current Profile" style="max-width: 200px; max-height: 200px;">
                                </div>
                            <% } %>
                        </div>

                        <div class="mb-3">
                            <label for="introVideo" class="form-label">Introduction Video</label>
                            <input type="file" class="form-control" id="introVideo" name="introVideo" accept="video/*">
                            <% if(translator.introVideo) { %>
                                <div class="mt-2">
                                    <video width="100%" controls>
                                        <source src="<%= translator.introVideo %>" type="video/mp4">
                                        Your browser does not support the video tag.
                                    </video>
                                </div>
                            <% } %>
                            <small class="text-muted">Upload a short video introducing yourself (MP4 format recommended)</small>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger">Update Profile</button>
                            <a href="/translator/dashboard" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %> 