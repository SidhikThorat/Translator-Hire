<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Client Guide - Translator Hire</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
    <link rel="stylesheet" href="/styles/main.css">
    <style>
        .guide-section {
            transition: transform 0.3s ease;
            cursor: pointer;
        }
        .guide-section:hover {
            transform: translateY(-10px);
        }
        .step-number {
            width: 40px;
            height: 40px;
            background-color: #dc3545;
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            margin-right: 15px;
        }
        .step-content {
            flex: 1;
        }
        .step-item {
            display: flex;
            align-items: center;
            margin-bottom: 15px;
            padding: 10px;
            border-radius: 8px;
            background-color: rgba(220, 53, 69, 0.05);
            transition: all 0.3s ease;
        }
        .step-item:hover {
            background-color: rgba(220, 53, 69, 0.1);
        }
        .icon-wrapper {
            width: 50px;
            height: 50px;
            background-color: #dc3545;
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 15px;
        }
        .section-title {
            color: #dc3545;
            font-weight: bold;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <%- include('../partials/header') %>
    
    <div class="container my-5">
        <div class="row">
            <div class="col-md-10 mx-auto">
                <h1 class="display-4 mb-4 text-center animate__animated animate__fadeIn">Client Guide</h1>
                <p class="lead text-center mb-5 animate__animated animate__fadeIn animate__delay-1s">A comprehensive guide to using Translator Hire as a client</p>

                <div class="row g-4">
                    <!-- Getting Started Section -->
                    <div class="col-md-6">
                        <div class="card h-100 guide-section animate__animated animate__fadeInUp">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="icon-wrapper">
                                        <i class="fas fa-rocket"></i>
                                    </div>
                                    <h2 class="section-title mb-0">Getting Started</h2>
                                </div>
                                <div class="step-item">
                                    <div class="step-number">1</div>
                                    <div class="step-content">Click on "Sign Up" in the navigation bar</div>
                                </div>
                                <div class="step-item">
                                    <div class="step-number">2</div>
                                    <div class="step-content">Fill in your personal and company information</div>
                                </div>
                                <div class="step-item">
                                    <div class="step-number">3</div>
                                    <div class="step-content">Upload your profile picture and company logo</div>
                                </div>
                                <div class="step-item">
                                    <div class="step-number">4</div>
                                    <div class="step-content">Verify your email address</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Profile Setup Section -->
                    <div class="col-md-6">
                        <div class="card h-100 guide-section animate__animated animate__fadeInUp animate__delay-1s">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="icon-wrapper">
                                        <i class="fas fa-user-cog"></i>
                                    </div>
                                    <h2 class="section-title mb-0">Profile Setup</h2>
                                </div>
                                <div class="step-item">
                                    <div class="step-number">1</div>
                                    <div class="step-content">Complete your company profile with detailed information</div>
                                </div>
                                <div class="step-item">
                                    <div class="step-number">2</div>
                                    <div class="step-content">Specify your preferred languages and translation needs</div>
                                </div>
                                <div class="step-item">
                                    <div class="step-number">3</div>
                                    <div class="step-content">Set your budget preferences</div>
                                </div>
                                <div class="step-item">
                                    <div class="step-number">4</div>
                                    <div class="step-content">Add any specific requirements or preferences</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Finding Translators Section -->
                    <div class="col-md-6">
                        <div class="card h-100 guide-section animate__animated animate__fadeInUp animate__delay-2s">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="icon-wrapper">
                                        <i class="fas fa-search"></i>
                                    </div>
                                    <h2 class="section-title mb-0">Finding Translators</h2>
                                </div>
                                <div class="step-item">
                                    <div class="step-number">1</div>
                                    <div class="step-content">Browse available translators in your dashboard</div>
                                </div>
                                <div class="step-item">
                                    <div class="step-number">2</div>
                                    <div class="step-content">Use filters to find translators matching your needs</div>
                                </div>
                                <div class="step-item">
                                    <div class="step-number">3</div>
                                    <div class="step-content">Review translator profiles, ratings, and previous work</div>
                                </div>
                                <div class="step-item">
                                    <div class="step-number">4</div>
                                    <div class="step-content">Contact potential translators through messaging</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Posting Projects Section -->
                    <div class="col-md-6">
                        <div class="card h-100 guide-section animate__animated animate__fadeInUp animate__delay-2s">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="icon-wrapper">
                                        <i class="fas fa-tasks"></i>
                                    </div>
                                    <h2 class="section-title mb-0">Posting Projects</h2>
                                </div>
                                <div class="step-item">
                                    <div class="step-number">1</div>
                                    <div class="step-content">Click "Post Project" in your dashboard</div>
                                </div>
                                <div class="step-item">
                                    <div class="step-number">2</div>
                                    <div class="step-content">Fill in project details and requirements</div>
                                </div>
                                <div class="step-item">
                                    <div class="step-number">3</div>
                                    <div class="step-content">Specify budget and timeline</div>
                                </div>
                                <div class="step-item">
                                    <div class="step-number">4</div>
                                    <div class="step-content">Upload any reference materials</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Managing Projects Section -->
                    <div class="col-md-6">
                        <div class="card h-100 guide-section animate__animated animate__fadeInUp animate__delay-3s">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="icon-wrapper">
                                        <i class="fas fa-project-diagram"></i>
                                    </div>
                                    <h2 class="section-title mb-0">Managing Projects</h2>
                                </div>
                                <div class="step-item">
                                    <div class="step-number">1</div>
                                    <div class="step-content">Review translator proposals</div>
                                </div>
                                <div class="step-item">
                                    <div class="step-number">2</div>
                                    <div class="step-content">Select the best translator for your project</div>
                                </div>
                                <div class="step-item">
                                    <div class="step-number">3</div>
                                    <div class="step-content">Communicate project requirements clearly</div>
                                </div>
                                <div class="step-item">
                                    <div class="step-number">4</div>
                                    <div class="step-content">Track project progress in your dashboard</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Payment Process Section -->
                    <div class="col-md-6">
                        <div class="card h-100 guide-section animate__animated animate__fadeInUp animate__delay-3s">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="icon-wrapper">
                                        <i class="fas fa-money-bill-wave"></i>
                                    </div>
                                    <h2 class="section-title mb-0">Payment Process</h2>
                                </div>
                                <div class="step-item">
                                    <div class="step-number">1</div>
                                    <div class="step-content">Set up your payment method in your profile</div>
                                </div>
                                <div class="step-item">
                                    <div class="step-number">2</div>
                                    <div class="step-content">Review and approve project milestones</div>
                                </div>
                                <div class="step-item">
                                    <div class="step-number">3</div>
                                    <div class="step-content">Make secure payments through the platform</div>
                                </div>
                                <div class="step-item">
                                    <div class="step-number">4</div>
                                    <div class="step-content">Track your payment history</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Best Practices Section -->
                    <div class="col-md-6">
                        <div class="card h-100 guide-section animate__animated animate__fadeInUp animate__delay-3s">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="icon-wrapper">
                                        <i class="fas fa-star"></i>
                                    </div>
                                    <h2 class="section-title mb-0">Best Practices</h2>
                                </div>
                                <div class="step-item">
                                    <div class="step-number">1</div>
                                    <div class="step-content">Provide clear project requirements</div>
                                </div>
                                <div class="step-item">
                                    <div class="step-number">2</div>
                                    <div class="step-content">Maintain open communication with translators</div>
                                </div>
                                <div class="step-item">
                                    <div class="step-number">3</div>
                                    <div class="step-content">Provide timely feedback on completed work</div>
                                </div>
                                <div class="step-item">
                                    <div class="step-number">4</div>
                                    <div class="step-content">Build long-term relationships with reliable translators</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="text-center mt-5">
                    <a href="/manual" class="btn btn-danger btn-lg animate__animated animate__fadeIn animate__delay-4s">
                        <i class="fas fa-arrow-left me-2"></i>Back to User Manual
                    </a>
                </div>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Add animation on scroll
        document.addEventListener('DOMContentLoaded', function() {
            const sections = document.querySelectorAll('.guide-section');
            
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('animate__fadeInUp');
                    }
                });
            }, { threshold: 0.1 });

            sections.forEach(section => {
                observer.observe(section);
            });
        });
    </script>
</body>
</html> 